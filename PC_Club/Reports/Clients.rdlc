  <Code>Public Function Ratio(ByVal a As Object, ByVal b As Object) As Double
    If a Is Nothing OrElse b Is Nothing Then Return 0
    If CDbl(b) = 0 Then Return 0
    Return CDbl(a) / CDbl(b)
End Function

Public Function HeatColor(ByVal v As Double) As String
    If v &lt; 0.1 Then Return "#FFFFFF"
    If v &lt; 0.2 Then Return "#FDEDE0"
    If v &lt; 0.35 Then Return "#FBCBA6"
    If v &lt; 0.5 Then Return "#F6A06B"
    If v &lt; 0.65 Then Return "#EC6D3A"
    Return "#C2381E"
End Function

Public Function HeatText(ByVal v As Double) As String
    If v &gt;= 0.5 Then Return "White"
    Return "Black"
End Function

Public Function Change(ByVal cur As Object, ByVal prev As Object) As String
    If cur Is Nothing OrElse prev Is Nothing Then Return "—"
    If CDbl(prev) = 0 Then Return "—"
    Dim p As Double = (CDbl(cur) - CDbl(prev)) / CDbl(prev)
    Dim sign As String = "▲ "
    If p &lt; 0 Then sign = "▼ "
    Return sign &amp; Math.Abs(p).ToString("P1")
End Function

Public Function ChangeColor(ByVal cur As Object, ByVal prev As Object) As String
    If cur Is Nothing OrElse prev Is Nothing Then Return "Black"
    If CDbl(prev) = 0 Then Return "Black"
    If CDbl(cur) &gt;= CDbl(prev) Then Return "ForestGreen"
    Return "Firebrick"
End Function</Code>
