extRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>#B4B4B4</Color><Style>Solid</Style></Border><BackgroundColor>#E6E6E6</BackgroundColor><PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember><TablixMember><Group Name="ByEmployee"><GroupExpressions><GroupExpression>=Fields!Employee.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Sum(Fields!Amount.Value)</Value><Direction>Descending</Direction></SortExpression></SortExpressions><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="ByMethod"><GroupExpressions><GroupExpression>=Fields!Method.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!Method.Value</Value></SortExpression></SortExpressions></TablixMember></TablixMembers></TablixMember><TablixMember><KeepWithGroup>Before</KeepWithGroup></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>Deposits</DataSetName><Top>16.6cm</Top><Left>6.5cm</Left><Height>2.20cm</Height><Width>11.50cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>23cm</Height><Style /></Body><Width>18cm</Width><Page><PageFooter><Height>0.6cm</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><ReportItems><Textbox Name="PageNo"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Сторінка &quot; &amp; Globals!PageNumber &amp; &quot; з &quot; &amp; Globals!TotalPages</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><Color>DimGray</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Top>0cm</Top><Left>12cm</Left><Height>0.5cm</Height><Width>6cm</Width><Style><Border><Style>None</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></ReportItems><Style /></PageFooter><PageHeight>29.7cm</PageHeight><PageWidth>21cm</PageWidth><LeftMargin>1.5cm</LeftMargin><RightMargin>1.5cm</RightMargin><TopMargin>1.2cm</TopMargin><BottomMargin>1.2cm</BottomMargin><Style /></Page></ReportSection></ReportSections><ReportParameters><ReportParameter Name="PeriodFrom"><DataType>String</DataType><Prompt>З</Prompt></ReportParameter><ReportParameter Name="PeriodTo"><DataType>String</DataType><Prompt>По</Prompt></ReportParameter></ReportParameters><Code>Public Function Ratio(ByVal a As Object, ByVal b As Object) As Double
    If a Is Nothing OrElse b Is Nothing Then Return 0
    If CDbl(b) = 0 Then Return 0
    Return CDbl(a) / CDbl(b)
End Function

Public Function HeatColor(ByVal v As Double) As String
    If v &lt; 0.1 Then Return &quot;#FFFFFF&quot;
    If v &lt; 0.2 Then Return &quot;#FDEDE0&quot;
    If v &lt; 0.35 Then Return &quot;#FBCBA6&quot;
    If v &lt; 0.5 Then Return &quot;#F6A06B&quot;
    If v &lt; 0.65 Then Return &quot;#EC6D3A&quot;
    Return &quot;#C2381E&quot;
End Function

Public Function HeatText(ByVal v As Double) As String
    If v &gt;= 0.5 Then Return &quot;White&quot;
    Return &quot;Black&quot;
End Function

Public Function Change(ByVal cur As Object, ByVal prev As Object) As String
    If cur Is Nothing OrElse prev Is Nothing Then Return &quot;—&quot;
    If CDbl(prev) = 0 Then Return &quot;—&quot;
    Dim p As Double = (CDbl(cur) - CDbl(prev)) / CDbl(prev)
    Dim sign As String = &quot;▲ &quot;
    If p &lt; 0 Then sign = &quot;▼ &quot;
    Return sign &amp; Math.Abs(p).ToString(&quot;P1&quot;)
End Function

Public Function ChangeColor(ByVal cur As Object, ByVal prev As Object) As String
    If cur Is Nothing OrElse prev Is Nothing Then Return &quot;Black&quot;
    If CDbl(prev) = 0 Then Return &quot;Black&quot;
    If CDbl(cur) &gt;= CDbl(prev) Then Return &quot;ForestGreen&quot;
    Return &quot;Firebrick&quot;
End Function</Code><Language>uk-UA</Language><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>811b90e2-c598-461b-966e-33c0802c1615</rd:ReportID></Report>
